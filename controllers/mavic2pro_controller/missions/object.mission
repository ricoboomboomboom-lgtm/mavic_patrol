# Объектная разведка. Меняются только эти параметры:
#   altitude — высота над площадкой, метры
#   center   — точка объекта, X на восток и Y на север
#   radius   — радиус круга, метры
#   laps     — число кругов
# polygon, path, width и lane_spacing этот режим не читает.
# Строку center убирать нельзя: без неё задание не примется.

mode = object
altitude = 1
center = 12 0
radius = 20
laps = 1
