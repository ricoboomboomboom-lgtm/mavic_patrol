# Маршрутная разведка. Меняются только эти параметры:
#   altitude     — высота над площадкой, метры
#   width        — полная ширина полосы осмотра, метры
#   lane_spacing — точный шаг между соседними проходами, метры
#   path         — точки ломаной по порядку
# Пока ширина меньше двух шагов, дрон идёт одной линией по середине.
# При ширине 16 и шаге 8 будут два прохода, и между ними ровно 8 м.
# polygon, radius, laps и center этот режим не читает.

mode = route
altitude = 1
width = 8
lane_spacing = 8
path =
  -30 -10
  30 -10
  30 20
