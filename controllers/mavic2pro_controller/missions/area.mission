# Площадная разведка. Меняются только эти параметры:
#   altitude     — высота над площадкой, метры
#   lane_spacing — точный шаг между галсами, метры
#   polygon      — углы района по порядку обхода
# Координаты: X на восток, Y на север, ноль в центре площадки.
# width, radius, laps, center и path этот режим не читает.

mode = area
altitude = 1
lane_spacing = 5
polygon =
  -20 -20
  20 -20
  20 20
  -20 20
