# Площадная разведка.
# Координаты в метрах карты: X на восток, Y на север, ноль в центре площадки.
# polygon — углы района по порядку обхода.
# lane_spacing — шаг между галсами. altitude — высота над площадкой.

mode = area
altitude = 1
lane_spacing = 5
polygon =
  -20 -20
  20 -20
  20 20
  -20 20
