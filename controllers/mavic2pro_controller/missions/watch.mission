# Дозор. Меняются только эти параметры:
#   altitude — высота над площадкой, метры
#   laps     — сколько раз обойти контур
#   polygon  — вершины контура по порядку
# Первую точку в конце повторять не нужно: контроллер замыкает контур сам.
# path, width, lane_spacing, radius и center этот режим не читает.

mode = watch
altitude = 1
laps = 2
polygon =
  -12 -8
  12 -8
  12 8
  -12 8
