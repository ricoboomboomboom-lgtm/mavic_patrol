WorldInfo {
  info [
    "500 x 500 m demonstration map. Flat takeoff square, 96 m, at the origin."
    "Launch bat chooses mavic_manual (TX12) or mavic2pro_controller (patrol)."
    "Patrol takes off to 1 m, scans a 10 x 10 m rectangle, returns, and lands."
    "Warehouses and container stacks collide. Water on the east side is visual."
  ]
  title "Порт 500 м"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
Viewpoint {
  orientation -0.11914522061843065 0 0.9928768384869221 2.7
  position 120.0 -58.0 70.0
  near 0.5
  far 4000
  follow "Mavic 2 PRO"
  followSmoothness 0.25
}
