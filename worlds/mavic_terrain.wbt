WorldInfo {
  info [
    "500 x 500 m demonstration map. Flat takeoff square, 96 m, at the origin."
    "Launch bat chooses mavic_manual (TX12) or mavic2pro_controller (patrol)."
    "Patrol takes off to 1 m, scans a 10 x 10 m rectangle, returns, and lands."
    "Hills up to about 25 m. Tree trunks collide, canopies do not."
  ]
  title "Холмы и лес 500 м"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
