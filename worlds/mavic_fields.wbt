  translation 0 0 -0.2
  name "ground"
  children [
    Shape {
      appearance Grass {
        type "mossy"
        textureTransform TextureTransform {
          scale 100 100
        }
      }
      geometry Box { size 500 500 0.4 }
    }
  ]
  boundingObject Box { size 500 500 0.4 }
}
