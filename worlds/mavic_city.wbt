WorldInfo {
  info [
    "300 x 300 m city grid. Streets are 12 m. Open square, 48 m, at the origin is the takeoff pad."
    "Manual flight. Controller: mavic_manual. Same sensors and supervisor flag as mavic_manual.wbt."
    "Building walls and roofs collide. The square and sidewalks are visual only; the ground plane is flat at z = 0."
  ]
  title "Mavic city 300 m"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
